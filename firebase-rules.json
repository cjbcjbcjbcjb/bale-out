{
  "rules": {
    "scores": {
      ".read": true,
      ".indexOn": ["s", "id"],
      "$entry": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['id', 'n', 's'])",
        "id": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
        "s": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 99999999" },
        "l": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" },
        "d": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    }
  }
}
